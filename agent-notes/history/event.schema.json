{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-notes/history/event.schema.json",
  "title": "Agent development event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp_utc",
    "task_id",
    "type",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "plan",
        "checkpoint",
        "experiment",
        "decision",
        "failure",
        "map_update",
        "verification",
        "handoff",
        "completion"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "plan_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_class": {
      "enum": [
        "EXACT",
        "NUMERICAL",
        "APPROXIMATE",
        "ESTIMATOR",
        "N/A",
        null
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

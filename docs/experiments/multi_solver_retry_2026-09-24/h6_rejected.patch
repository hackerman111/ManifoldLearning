+def test_relative_precision_may_be_tighter_than_old_backward_error_floor(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Большой несогласованный residual не оправдывает повышение ridge."""
+    rng = np.random.default_rng(20260924)
+    U = rng.normal(size=(9, 7, 4))
+    B = np.linalg.qr(rng.normal(size=(4, 2)))[0].T
+    c = rng.normal(size=(9, 2))
+    A = HYBRID.design_matrix(U, c, np.ones(9))
+    left, _, _ = np.linalg.svd(A, full_matrices=True)
+    residual = 100 * left[:, -1] + 1e-5 * (A @ rng.normal(size=8))
+    I = residual.reshape(9, 7) + HYBRID.forward(U, B, c)
+    workspace = HYBRID.RidgeWorkspace(
+        U, I, B, c, np.ones(9), max_unknowns=0, max_bytes=0
+    )
+    original = HYBRID._lsmr_method
+    seen = []
+
+    def record(operator, rhs, **settings):
+        seen.append(settings["atol"])
+        return original(operator, rhs, **settings)
+
+    monkeypatch.setattr(HYBRID, "_lsmr_method", record)
+    ridge = 0.1
+    result = workspace.correction(ridge, 1e-6, 200, relative_tol=0.01)
+    assert min(seen) < 1e-10
+    assert result[3] <= 0.01
+    expected = np.linalg.lstsq(
+        np.vstack((A, np.sqrt(ridge) * np.eye(8))),
+        np.concatenate((workspace.residual, np.zeros(8))),
+        rcond=None,
+    )[0]
+    assert np.linalg.norm(result[0] - expected) <= 0.01 * np.linalg.norm(result[0])
+
+

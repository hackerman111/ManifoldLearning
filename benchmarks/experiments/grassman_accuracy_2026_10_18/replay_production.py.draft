"""Isolated source-parity and saved-input replay; requires --execute to fit."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[2]
BASE = ROOT / "benchmark_outputs/r_sdr/grassman-intrinsic-validation-2026-10-18"
PILOT = ROOT / "experiments/grassman_accuracy_2026_10_18/frozen"
TOL = {
    "projector_frobenius": 1e-9,
    "coefficients_rtol": 1e-9,
    "coefficients_atol": 1e-9,
    "diagnostics_rtol": 1e-9,
    "diagnostics_atol": 1e-8,
}


def sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def encode(value):
    if isinstance(value, (np.ndarray, np.generic)):
        return value.tolist() if isinstance(value, np.ndarray) else value.item()
    raise TypeError(type(value).__name__)


def child(mode: str, source: Path, data_path: Path, meta: dict, output: Path) -> None:
    sys.path.insert(0, str(source))
    with np.load(data_path) as data:
        if "index_init" in data.files:
            index, U, I, mass = (data[k] for k in ("index_init", "U", "I", "mass"))
            if mode.endswith("warmup") and mode.startswith("frozen"):
                from experiments.grassman_accuracy_2026_10_18.warmup import solve

                kwargs = {"max_steps": 10, "tol": 1e-6, "smooth_max_steps": 5}
            else:
                from ADP.solver.grassman import solve

                kwargs = {}
                if mode.endswith("warmup"):
                    kwargs = {"max_steps": 10, "tol": 1e-6, "intrinsic_gn": True}
            result = solve(index, U, I, mass=mass, **kwargs)
            payload = {
                "index": result.index,
                "coefficients": result.coefficients,
                "diagnostics": result.diagnostics,
            }
        else:
            x, y, truth = (data[k] for k in ("x", "y", "truth"))
            from ADP.core.ADP_Config import ADP_Config
            from ADP.core.ADP_Solver import ADP_solver
            from ADP.core.multi.ADP_multi_index import ADP_multi_index
            from experiments.r_sdr.design import metrics

            if mode == "frozen-warmup":
                from experiments.grassman_accuracy_2026_10_18.warmup import solve

                settings = meta["solver"]
            else:
                from ADP.solver.grassman import solve as base_solve

                settings = {
                    k: v for k, v in meta["solver"].items() if k != "smooth_max_steps"
                }

                def solve(index, U, I, **kwargs):
                    return base_solve(index, U, I, intrinsic_gn=True, **kwargs)

            model = ADP_multi_index(
                2,
                config=ADP_Config(seed=meta["method_seed"], **meta["config"]),
                solver=ADP_solver(solve, **settings),
            ).fit(x, y)
            payload = {
                "basis": model.basis_,
                "coefficients": model.coefficients_,
                "diagnostics": model.solver_diagnostics_,
                "stop_reason": model.result_.stop_reason,
                "quality": metrics(model.basis_, truth),
            }
    output.write_text(json.dumps(payload, default=encode, allow_nan=False))


def flatten(value):
    if isinstance(value, dict):
        return [x for key in sorted(value) for x in flatten(value[key])]
    if isinstance(value, list):
        return [x for item in value for x in flatten(item)]
    return (
        [float(value)]
        if isinstance(value, (int, float)) and not isinstance(value, bool)
        else []
    )


def compare(a: dict, b: dict) -> dict:
    key = "index" if "index" in a else "basis"
    left, right = np.asarray(a[key]), np.asarray(b[key])
    if key == "index":
        left, right = left.T, right.T
    q1, _ = np.linalg.qr(left)
    q2, _ = np.linalg.qr(right)
    pdiff = float(np.linalg.norm(q1 @ q1.T - q2 @ q2.T))
    c1, c2 = np.asarray(a["coefficients"]), np.asarray(b["coefficients"])
    d1, d2 = flatten(a["diagnostics"]), flatten(b["diagnostics"])
    ddiff = (
        float(np.max(np.abs(np.asarray(d1) - d2)))
        if len(d1) == len(d2) and d1
        else None
    )
    return {
        "projector_frobenius": pdiff,
        "coefficient_max_abs": float(np.max(np.abs(c1 - c2)))
        if c1.shape == c2.shape
        else None,
        "diagnostic_max_abs": ddiff,
        "match": pdiff <= TOL["projector_frobenius"]
        and c1.shape == c2.shape
        and np.allclose(
            c1, c2, rtol=TOL["coefficients_rtol"], atol=TOL["coefficients_atol"]
        )
        and ddiff is not None
        and np.allclose(
            d1, d2, rtol=TOL["diagnostics_rtol"], atol=TOL["diagnostics_atol"]
        ),
    }


def preflight(candidate: Path, validation: Path) -> dict:
    old_manifest = json.loads((BASE / "manifest.json").read_text())
    old_source = BASE / "source"
    old_hash = sha(old_source / "ADP/solver/grassman.py")
    if old_manifest["protocol"]["sources"].get("ADP/solver/grassman.py") != old_hash:
        raise ValueError("frozen baseline Grassmann source hash mismatch")
    manifest_path = candidate.parent / "manifest.json"
    candidate_manifest = json.loads(manifest_path.read_text())
    expected = candidate_manifest["protocol"]["sources"]
    for rel in (
        "ADP/solver/grassman.py",
        "experiments/grassman_accuracy_2026_10_18/warmup.py",
        "experiments/grassman_accuracy_2026_10_18/backtracking.py",
    ):
        if expected.get(rel) != sha(candidate / rel):
            raise ValueError(f"frozen warmup source hash mismatch: {rel}")
    protocol = json.loads((validation / "manifest.json").read_text())["protocol"]
    rows = [
        json.loads(line)
        for line in (validation / "runs.jsonl").read_text().splitlines()
    ]
    cases = {}
    for name, d in (("d-5", 5), ("d-20", 20), ("d-50", 50)):
        path = validation / "inputs" / f"{name}-102800.npz"
        with np.load(path) as data:
            if data["x"].shape != (500, d) or data["truth"].shape != (d, 2):
                raise ValueError(f"saved replay shape mismatch: {path}")
            data_hash = hashlib.sha256(
                data["x"].tobytes() + data["y"].tobytes() + data["truth"].tobytes()
            ).hexdigest()
        matching = [r for r in rows if r["case"] == name and r["seed"] == 102800]
        if not matching or any(r["data_sha256"] != data_hash for r in matching):
            raise ValueError(f"missing/mismatched validation input: {name}")
        cases[name] = {
            "input": str(path),
            "config": protocol["adp_config"][name],
            "method_seed": matching[0]["method_seed"],
            "solver": protocol["intrinsic_solver"],
        }
    pilot = [PILOT / f"{i:03}.npz" for i in range(1, 15)]
    return {
        "baseline_hash": old_hash,
        "candidate_manifest": candidate_manifest["fingerprint"],
        "production_hash": sha(ROOT / "ADP/solver/grassman.py"),
        "pilot": [str(x) for x in pilot],
        "fullfit": cases,
    }


def run_one(mode: str, source: Path, data: Path, meta: dict | None) -> dict:
    with tempfile.TemporaryDirectory(prefix="grassman-replay-") as folder:
        out = Path(folder) / "out.json"
        env = os.environ | {
            "PYTHONPATH": f"{ROOT}:{source}",
            "OPENBLAS_NUM_THREADS": "1",
            "OMP_NUM_THREADS": "1",
            "MKL_NUM_THREADS": "1",
        }
        code = (
            f"import sys; sys.path.insert(0,{str(ROOT)!r}); from pathlib import Path; "
            "from experiments.grassman_accuracy_2026_10_18.replay_production import child; "
            "child(sys.argv[1],Path(sys.argv[2]),Path(sys.argv[3]),json.loads(sys.argv[4]),Path(sys.argv[5]))"
        )
        proc = subprocess.run(
            [
                sys.executable,
                "-c",
                "import json; " + code,
                mode,
                str(source),
                str(data),
                json.dumps(meta or {}),
                str(out),
            ],
            cwd=source,
            env=env,
            capture_output=True,
            text=True,
        )
        if proc.returncode:
            raise RuntimeError(proc.stderr[-2000:])
        return json.loads(out.read_text())


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--candidate-source", type=Path, required=True)
    parser.add_argument("--validation-dir", type=Path, required=True)
    parser.add_argument("--execute", action="store_true")
    args = parser.parse_args()
    info = preflight(args.candidate_source, args.validation_dir)
    if not args.execute:
        print(json.dumps({"preflight": info, "tolerances": TOL}, indent=2))
        return
    old, candidate = BASE / "source", args.candidate_source
    pairs = (
        ("baseline", "frozen-default", "production-default", old, ROOT),
        ("warmup", "frozen-warmup", "production-warmup", candidate, ROOT),
    )
    results = {"preflight": info, "tolerances": TOL, "comparisons": {}}
    for path in map(Path, info["pilot"]):
        results["comparisons"][path.stem] = {
            label: compare(
                run_one(left, src1, path, None), run_one(right, src2, path, None)
            )
            for label, left, right, src1, src2 in pairs
        }
    for name, meta in info["fullfit"].items():
        ref = run_one("frozen-warmup", candidate, Path(meta["input"]), meta)
        live = run_one("production-warmup", ROOT, Path(meta["input"]), meta)
        results["comparisons"][name + "-fullfit"] = {
            "fit": compare(ref, live),
            "quality": {"reference": ref["quality"], "production": live["quality"]},
            "stop_reason": [ref["stop_reason"], live["stop_reason"]],
        }
    output = args.validation_dir / "production-replay.json"
    output.write_text(json.dumps(results, indent=2, allow_nan=False))
    print(output)


if __name__ == "__main__":
    main()
